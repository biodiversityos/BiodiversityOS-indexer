# Local development
DATABASE_URL=postgresql://user:password@localhost:5432/biodiversity_indexer
# Docker Compose (set automatically via docker-compose.yml environment block)
# DATABASE_URL=postgresql://biodiversity:biodiversity@db:5432/biodiversity_indexer
