generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Record {
  id          Int       @id
  latitude    Float
  longitude   Float
  species     String
  count       Int
  behavior    String
  /// Null when the field date is genuinely unknown, rather than faking epoch 0.
  observedAt  DateTime?
  mediaUrl    String?
  comment     String?
  siteName    String?
  depthFt     Int?
  sizeClass   String?
  reporter    String
  blockNumber BigInt
  txHash      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([species])
  @@index([observedAt])
  @@index([siteName])
}

model IndexerState {
  id        Int    @id @default(1)
  lastBlock BigInt @default(0)
}
